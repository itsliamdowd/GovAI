# Copy to .env and fill in. Loaded by `npm start` via node --env-file.
ANTHROPIC_API_KEY=sk-ant-...
PORT=8787

# Optional official YouTube uploads + public transcript importer (server-side only).
YOUTUBE_API_KEY=

# Daily watch alerts (optional)
# JUDGE_MODEL=claude-haiku-5-5   # yes/no "did anything change" judge
# ALERT_HOUR=7                   # local hour the daily check runs
# RESEND_API_KEY=re_...          # if unset, emails are written to data/outbox/ instead
# ALERT_FROM="Santa Monica Assistant <alerts@yourdomain.gov>"

# Voice mode TTS (optional). With a key, replies are spoken by ElevenLabs; without it, the best browser voice is used.
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM   # Rachel; any voice id from your ElevenLabs library
# ELEVENLABS_MODEL=eleven_turbo_v2_5

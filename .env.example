# Copy to .env and fill in. Loaded by `npm start` via node --env-file.
ANTHROPIC_API_KEY=sk-ant-...
PORT=8787

# Daily watch alerts (optional)
# JUDGE_MODEL=claude-haiku-5-5   # yes/no "did anything change" judge
# ALERT_HOUR=7                   # local hour the daily check runs
# RESEND_API_KEY=re_...          # if unset, emails are written to data/outbox/ instead
# ALERT_FROM="Santa Monica Assistant <alerts@yourdomain.gov>"

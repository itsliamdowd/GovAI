{
  "name": "govai",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "test": "node test.js",
    "ingest:youtube": "node scripts/run_youtube.js",
    "test:youtube": "python3 -m unittest discover -s tests -p 'test_youtube.py' && node --test tests/youtube.test.js",
    "dev": "node --watch --env-file=.env server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest"
  }
}

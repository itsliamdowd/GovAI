

<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <title>Document Not Found</title>
    <link href="/Content/css/vendor/bootstrap.min.css" rel="stylesheet" />
    <style>
        .center img {
            height: 70px;
            display: block;
            margin-left: auto;
            margin-right: auto;
        }

        .error-text {
            width: 50%;
            margin: 70px auto;
            color: red !important;
        }

        .portal-link {
            text-decoration: underline;
            color: red !important;
        }
    </style>
</head>
<body>
    <div style="margin-top: 10%">
        <div class="center">
            <img class="" src="/content/images/default/onemeeting_logo.png" title="OneMeeting Logo">
        </div>
        <div class="error-text">
            <h5>The requested meeting document is no longer available. Please return to the <a class="portal-link" href="/public/portal">Meeting Portal</a> if you wish to select a different meeting document.</h5>
        </div>
    </div>
</body>
</html>